---
import { formatDate, collectionUrl, withBase } from '../utils/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'world'>;
  showCover?: boolean;
}

const { entry, showCover = false } = Astro.props;
const {
  title,
  description,
  date,
  minecraftVersion,
  phase,
  location,
  cover,
  tags,
} = entry.data;
const href = collectionUrl('world', entry.id);
---

<article class="timeline-card">
  <div class="timeline-card__marker" aria-hidden="true">
    <span class="timeline-card__dot"></span>
  </div>
  <div class="timeline-card__content">
    <a href={href} class="timeline-card__link">
      <div class="timeline-card__header">
        <time class="timeline-card__date" datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="tag">{phase}</span>
      </div>
      <h3 class="timeline-card__title">{title}</h3>
      <p class="timeline-card__desc">{description}</p>
      <div class="timeline-card__meta">
        <span>v{minecraftVersion}</span>
        {location && <span>{location}</span>}
      </div>
      {tags.length > 0 && (
        <div class="timeline-card__tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </a>
    {showCover && cover && (
      <a href={href} class="timeline-card__image-link" tabindex="-1" aria-hidden="true">
        <img src={withBase(cover)} alt="" class="timeline-card__image" loading="lazy" />
      </a>
    )}
  </div>
</article>

<style>
  .timeline-card {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--space-md);
    align-items: start;
  }

  .timeline-card__marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-md);
  }

  .timeline-card__marker::after {
    content: '';
    flex: 1;
    width: 2px;
    min-height: var(--space-md);
    background: var(--color-border-strong);
    margin-top: var(--space-sm);
  }

  .timeline-card__dot {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    background: var(--color-accent);
    border: 2px solid var(--color-accent-dark);
    box-shadow: 0 0 0 3px var(--color-accent-light);
  }

  .timeline-card__content {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition);
  }

  .timeline-card__content:hover {
    box-shadow: var(--shadow-md);
  }

  .timeline-card__link {
    display: block;
    padding: var(--space-lg);
    text-decoration: none;
    color: inherit;
  }

  .timeline-card__link:hover {
    color: inherit;
  }

  .timeline-card__header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    margin-bottom: var(--space-sm);
  }

  .timeline-card__date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .timeline-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0 0 var(--space-sm);
    line-height: 1.3;
  }

  .timeline-card__desc {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-sm);
    line-height: 1.55;
  }

  .timeline-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .timeline-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .timeline-card__image-link {
    display: block;
    border-top: 1px solid var(--color-border);
  }

  .timeline-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  @media (max-width: 600px) {
    .timeline-card {
      grid-template-columns: 1.25rem 1fr;
    }
  }
</style>
