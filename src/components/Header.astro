---
import { siteConfig } from '../config/site';
import { withBase } from '../utils/content';

const navItems = [
  { label: 'Home', href: withBase('/') },
  { label: 'Articles', href: withBase('/articles/') },
  { label: 'World', href: withBase('/world/') },
];

const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === withBase('/')) {
    const home = withBase('/').replace(/\/$/, '');
    return path === withBase('/') || path.replace(/\/$/, '') === home;
  }
  return path.startsWith(href);
}
---

<header class="header">
  <nav class="header__nav container" aria-label="Main navigation">
    <a href={withBase('/')} class="header__logo">
      <span class="header__logo-block" aria-hidden="true"></span>
      <span class="header__logo-text">{siteConfig.title}</span>
    </a>

    <button class="header__toggle" aria-expanded="false" aria-controls="nav-menu" id="nav-toggle">
      <span class="sr-only">Toggle menu</span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <div class="header__menu" id="nav-menu">
      <ul class="header__links">
        {navItems.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class:list={['header__link', { 'header__link--active': isActive(href) }]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        ))}
        <li class="header__dropdown">
          <button class="header__link header__dropdown-trigger" aria-expanded="false" id="external-toggle">
            External
            <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
          </button>
          <ul class="header__dropdown-menu" id="external-menu">
            {siteConfig.externalLinks.map(({ label, href, description }) => (
              <li>
                <a href={href} target="_blank" rel="noopener noreferrer">
                  <strong>{label}</strong>
                  <span>{description}</span>
                </a>
              </li>
            ))}
          </ul>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const externalToggle = document.getElementById('external-toggle');
  const externalMenu = document.getElementById('external-menu');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('header__menu--open');
  });

  externalToggle?.addEventListener('click', () => {
    const expanded = externalToggle.getAttribute('aria-expanded') === 'true';
    externalToggle.setAttribute('aria-expanded', String(!expanded));
    externalMenu?.classList.toggle('header__dropdown-menu--open');
  });

  document.addEventListener('click', (e) => {
    if (!externalToggle?.contains(e.target as Node) && !externalMenu?.contains(e.target as Node)) {
      externalToggle?.setAttribute('aria-expanded', 'false');
      externalMenu?.classList.remove('header__dropdown-menu--open');
    }
  });
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-height);
    background: rgba(250, 250, 248, 0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.125rem;
  }

  .header__logo-block {
    width: 1.25rem;
    height: 1.25rem;
    background: var(--color-accent);
    border: 2px solid var(--color-accent-dark);
    box-shadow: 2px 2px 0 var(--color-accent-dark);
  }

  .header__toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-sm);
    background: none;
    border: 1px solid var(--color-border);
    cursor: pointer;
  }

  .header__toggle-bar {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: var(--color-text);
  }

  .header__menu {
    display: flex;
    align-items: center;
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-md);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition: color var(--transition), background var(--transition);
  }

  .header__link:hover,
  .header__link--active {
    color: var(--color-accent-dark);
    background: var(--color-accent-light);
  }

  .header__dropdown {
    position: relative;
  }

  .header__dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    min-width: 14rem;
    list-style: none;
    margin: var(--space-xs) 0 0;
    padding: var(--space-sm);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all var(--transition);
  }

  .header__dropdown-menu--open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .header__dropdown-menu a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-sm) var(--space-md);
    text-decoration: none;
    color: var(--color-text);
    transition: background var(--transition);
  }

  .header__dropdown-menu a:hover {
    background: var(--color-bg-alt);
  }

  .header__dropdown-menu span {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .header__toggle {
      display: flex;
    }

    .header__menu {
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      background: var(--color-bg-card);
      border-bottom: 1px solid var(--color-border);
      padding: var(--space-md);
      display: none;
    }

    .header__menu--open {
      display: block;
    }

    .header__links {
      flex-direction: column;
      align-items: stretch;
    }

    .header__link {
      width: 100%;
      justify-content: flex-start;
    }

    .header__dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
      box-shadow: none;
      border: none;
      padding-left: var(--space-lg);
    }

    .header__dropdown-menu--open {
      display: block;
    }
  }
</style>
