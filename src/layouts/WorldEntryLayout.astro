---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { formatDate, withBase, collectionUrl, normalizeGalleryItem } from '../utils/content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'world'>;
  prev?: CollectionEntry<'world'>;
  next?: CollectionEntry<'world'>;
  relatedArticles?: { href: string; title: string }[];
  headings: { depth: number; text: string; slug: string }[];
}

const { entry, prev, next, relatedArticles = [], headings } = Astro.props;
const {
  title,
  description,
  date,
  minecraftVersion,
  phase,
  location,
  coordinates,
  tags,
  cover,
  gallery,
} = entry.data;

const galleryItems = gallery.map(normalizeGalleryItem);
---

<BaseLayout title={title} description={description} image={cover}>
  <article class="world-entry">
    <header class="world-entry__header">
      <div class="container container--narrow">
        <a href={withBase('/world/')} class="world-entry__back">← World timeline</a>
        <span class="inventory-label">{phase}</span>
        <h1 class="world-entry__title">{title}</h1>
        <p class="world-entry__desc">{description}</p>
        <dl class="world-entry__meta">
          <div><dt>Date</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
          <div><dt>Version</dt><dd>{minecraftVersion}</dd></div>
          {location && <div><dt>Location</dt><dd>{location}</dd></div>}
          {coordinates && <div><dt>Coordinates</dt><dd><code>{coordinates}</code></dd></div>}
        </dl>
        {tags.length > 0 && (
          <div class="world-entry__tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </div>
      {cover && (
        <div class="world-entry__cover-wrap container">
          <img src={withBase(cover)} alt="" class="world-entry__cover" />
        </div>
      )}
    </header>

    <div class="world-entry__layout container">
      {headings.length > 2 && (
        <aside class="world-entry__toc">
          <TableOfContents headings={headings} />
        </aside>
      )}
      <div class="world-entry__content prose">
        <slot />
      </div>
    </div>

    {galleryItems.length > 0 && (
      <section class="world-entry__gallery section">
        <div class="container">
          <span class="section__label">Gallery</span>
          <h2 class="section__title">Screenshots</h2>
          <div class="world-entry__gallery-grid">
            {galleryItems.map(({ src, caption }) => (
              <figure class="world-entry__gallery-item">
                <div class="world-entry__gallery-frame">
                  <img src={withBase(src)} alt={caption ?? ''} loading="lazy" />
                </div>
                {caption && <figcaption class="world-entry__gallery-caption">{caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="world-entry__related section">
        <div class="container container--narrow">
          <span class="section__label">Related</span>
          <h2 class="section__title">Related articles</h2>
          <ul class="world-entry__related-list">
            {relatedArticles.map(({ href, title: articleTitle }) => (
              <li><a href={href}>{articleTitle}</a></li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {(prev || next) && (
      <nav class="world-entry__nav container container--narrow" aria-label="Timeline navigation">
        {prev ? (
          <a href={collectionUrl('world', prev.id)} class="world-entry__nav-link">
            <span class="world-entry__nav-label">← Earlier</span>
            <span>{prev.data.title}</span>
          </a>
        ) : <div />}
        {next ? (
          <a href={collectionUrl('world', next.id)} class="world-entry__nav-link world-entry__nav-link--next">
            <span class="world-entry__nav-label">Later →</span>
            <span>{next.data.title}</span>
          </a>
        ) : <div />}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .world-entry__header {
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--color-bg-card);
    border-bottom: 1px solid var(--color-border);
  }

  .world-entry__back {
    display: inline-block;
    font-size: 0.875rem;
    margin-bottom: var(--space-lg);
    text-decoration: none;
  }

  .world-entry__title {
    margin: var(--space-sm) 0;
  }

  .world-entry__desc {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .world-entry__meta {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    gap: var(--space-md);
    margin: var(--space-lg) 0;
    padding: var(--space-lg);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
  }

  .world-entry__meta dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .world-entry__meta dd {
    margin: 0;
    font-weight: 500;
  }

  .world-entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .world-entry__cover-wrap {
    margin-top: var(--space-xl);
  }

  .world-entry__cover {
    width: 100%;
    max-height: 28rem;
    object-fit: cover;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .world-entry__layout {
    display: grid;
    grid-template-columns: 14rem 1fr;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
    align-items: start;
  }

  .world-entry__toc {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-lg));
  }

  .world-entry__content {
    min-width: 0;
  }

  .world-entry__gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-xl);
  }

  .world-entry__gallery-item {
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .world-entry__gallery-frame {
    height: 14rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition);
  }

  .world-entry__gallery-item:hover .world-entry__gallery-frame {
    box-shadow: var(--shadow-md);
  }

  .world-entry__gallery-frame img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .world-entry__gallery-caption {
    margin-top: var(--space-sm);
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    text-align: center;
  }

  .world-entry__related-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .world-entry__related-list li {
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .world-entry__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .world-entry__nav-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: border-color var(--transition);
  }

  .world-entry__nav-link:hover {
    border-color: var(--color-accent);
  }

  .world-entry__nav-link--next {
    text-align: right;
  }

  .world-entry__nav-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
  }

  @media (max-width: 900px) {
    .world-entry__layout {
      grid-template-columns: 1fr;
    }

    .world-entry__toc {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 600px) {
    .world-entry__nav {
      grid-template-columns: 1fr;
    }

    .world-entry__nav-link--next {
      text-align: left;
    }
  }
</style>
